<Window x:Class="Fako.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="名前の変更" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Icon="Assets/fako.ico"
        ThemeMode="System" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="Yu Gothic UI" FontSize="13" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" TextChanged="OnTextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="#FFE05050" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="96" IsDefault="True" Click="OnOk"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="キャンセル" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
