<Window x:Class="Fako.StyleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="フェンスの外観" Width="760" Height="640" MinWidth="680" MinHeight="520"
        Icon="Assets/fako.ico"
        ThemeMode="System" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13" ShowInTaskbar="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="2" BorderBrush="#40808080"
                                Background="{TemplateBinding Background}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF60AAFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,12,20,16">
        <!-- 下のボタン -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ResetButton" Content="既定の外観に戻す" Click="OnReset" />
            <Button x:Name="MakeDefaultButton" Content="新しいフェンスの既定にする" Margin="8,0,0,0" Click="OnMakeDefault" />
            <Button x:Name="ApplyAllButton" Content="すべてのフェンスに適用" Margin="8,0,0,0" Click="OnApplyAll" />
            <Button DockPanel.Dock="Right" Content="キャンセル" MinWidth="96" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
            <Button DockPanel.Dock="Right" Content="OK" MinWidth="96" IsDefault="True" Click="OnOk"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- 設定項目 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock x:Name="TargetText" Opacity="0.75" TextWrapping="Wrap" />

                    <TextBlock Text="背景" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="BackgroundSwatches" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="色" Style="{StaticResource Label}" />
                        <Button x:Name="BackgroundColorButton" Grid.Column="1" HorizontalAlignment="Left" Click="OnPickBackground" />
                        <TextBlock Grid.Row="1" Text="濃さ" Style="{StaticResource Label}" />
                        <Slider x:Name="BackgroundAlpha" Grid.Row="1" Grid.Column="1" Minimum="5" Maximum="100" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=BackgroundAlpha, StringFormat={}{0:0}%}" />
                    </Grid>

                    <TextBlock Text="タイトル" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="背景" Style="{StaticResource Label}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <CheckBox x:Name="TitleAuto" Content="自動" Checked="OnChanged" Unchecked="OnChanged" />
                            <Button x:Name="TitleBackgroundButton" Margin="12,0,0,0" Click="OnPickTitleBackground" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="背景の濃さ" Style="{StaticResource Label}" />
                        <Slider x:Name="TitleAlpha" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=TitleAlpha, StringFormat={}{0:0}%}" />
                        <TextBlock Grid.Row="2" Text="文字の色" Style="{StaticResource Label}" />
                        <Button x:Name="TitleColorButton" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnPickTitleColor" />
                        <TextBlock Grid.Row="3" Text="文字の大きさ" Style="{StaticResource Label}" />
                        <Slider x:Name="TitleSize" Grid.Row="3" Grid.Column="1" Minimum="9" Maximum="24" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=TitleSize, StringFormat={}{0:0} pt}" />
                        <TextBlock Grid.Row="4" Text="配置" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton x:Name="AlignLeft" Content="左" GroupName="Align" Checked="OnChanged" MinWidth="60" />
                            <RadioButton x:Name="AlignCenter" Content="中央" GroupName="Align" Checked="OnChanged" MinWidth="60" />
                            <RadioButton x:Name="AlignRight" Content="右" GroupName="Align" Checked="OnChanged" MinWidth="60" />
                        </StackPanel>
                        <CheckBox x:Name="TitleBold" Grid.Row="5" Grid.Column="1" Content="太字" Margin="0,8,0,0"
                                  Checked="OnChanged" Unchecked="OnChanged" />
                    </Grid>

                    <TextBlock Text="枠" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="線の色" Style="{StaticResource Label}" />
                        <Button x:Name="BorderColorButton" Grid.Column="1" HorizontalAlignment="Left" Click="OnPickBorder" />
                        <TextBlock Grid.Row="1" Text="線の濃さ" Style="{StaticResource Label}" />
                        <Slider x:Name="BorderAlpha" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=BorderAlpha, StringFormat={}{0:0}%}" />
                        <TextBlock Grid.Row="2" Text="線の太さ" Style="{StaticResource Label}" />
                        <Slider x:Name="BorderWidth" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="4" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=BorderWidth, StringFormat={}{0:0} px}" />
                        <TextBlock Grid.Row="3" Text="角の丸み" Style="{StaticResource Label}" />
                        <Slider x:Name="Corner" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="20" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=Corner, StringFormat={}{0:0} px}" />
                    </Grid>

                    <TextBlock Text="アイテムの文字" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="色" Style="{StaticResource Label}" />
                        <Button x:Name="TextColorButton" Grid.Column="1" HorizontalAlignment="Left" Click="OnPickTextColor" />
                        <TextBlock Grid.Row="1" Text="大きさ" Style="{StaticResource Label}" />
                        <Slider x:Name="TextSize" Grid.Row="1" Grid.Column="1" Minimum="9" Maximum="18" Margin="0,8,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ValueText}"
                                   Text="{Binding Value, ElementName=TextSize, StringFormat={}{0:0} pt}" />
                        <CheckBox x:Name="TextShadow" Grid.Row="2" Grid.Column="1" Content="影を付ける（明るい壁紙でも読みやすく）"
                                  Margin="0,8,0,0" Checked="OnChanged" Unchecked="OnChanged" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- プレビュー -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="プレビュー" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <Border CornerRadius="8" Padding="16" Height="250">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF3A6EA5" Offset="0" />
                            <GradientStop Color="#FF7A4E8C" Offset="0.55" />
                            <GradientStop Color="#FFE0A060" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border x:Name="PreviewRoot" VerticalAlignment="Top">
                        <DockPanel>
                            <Border x:Name="PreviewTitleBar" DockPanel.Dock="Top">
                                <TextBlock x:Name="PreviewTitle" Text="ツール" Margin="10,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <WrapPanel x:Name="PreviewItems" Margin="6,8,6,10" />
                        </DockPanel>
                    </Border>
                </Border>
                <TextBlock Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="12"
                           Text="対象のフェンスにもその場で反映されます。キャンセルすると元に戻ります。" x:Name="PreviewNote" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
