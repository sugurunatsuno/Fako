<Window x:Class="Fako.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fako"
        Title="Fako の設定" Width="900" Height="640" MinWidth="760" MinHeight="520"
        Icon="Assets/fako.ico"
        ThemeMode="System" WindowStartupLocation="CenterScreen"
        FontFamily="Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="28,2,0,6" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,8,16,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="96" IsDefault="True" Click="OnOk" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="キャンセル" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
            <Button Content="適用" MinWidth="96" Margin="8,0,0,0" Click="OnApply" />
        </StackPanel>

        <TabControl x:Name="Tabs">
            <!-- ===== 全般 ===== -->
            <TabItem Header="全般">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="起動" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="AutoStartBox" Content="Windows の起動時に Fako を開始する" />

                        <TextBlock Text="デスクトップ" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="DoubleClickBox" Content="デスクトップの何もない所をダブルクリックして、フェンスを隠す／表示する" />
                        <TextBlock Text="デスクトップのアイコン" Style="{StaticResource SectionTitle}" />
                        <RadioButton x:Name="ManagedRadio" GroupName="IconMode" Content="フェンスで管理する（おすすめ）" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Windows 標準のデスクトップ アイコンを非表示にして、すべてフェンスに表示します。どのフェンスにも入っていない項目（ごみ箱なども）は「未整理」フェンスに表示します（無ければ自動で作ります）。ファイルそのものには触らないので、エクスプローラーでは普通に見えます。Fako を終了すると標準のアイコンに戻ります。" />
                        <RadioButton x:Name="NotManagedRadio" GroupName="IconMode" Content="管理しない" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Windows 標準のデスクトップ アイコンもそのまま表示します（フェンスに入れた項目は、デスクトップとフェンスの両方に表示されます）。" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== スナップ ===== -->
            <TabItem Header="スナップ">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="フェンス同士のスナップ" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="SnapBox" Content="移動・サイズ変更のときに、近くのフェンスの端に吸着させる" />
                    <CheckBox x:Name="SnapEdgesBox" Content="画面の端（タスクバーを除いた領域）にも吸着させる" />
                    <TextBlock Style="{StaticResource Hint}" Text="Alt キーを押しながら動かすと、一時的に吸着しません。" />

                    <Grid Margin="0,12,0,0" MaxWidth="560" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="吸着する距離" VerticalAlignment="Center" />
                        <Slider x:Name="SnapDistanceSlider" Grid.Column="1" Minimum="4" Maximum="40" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=SnapDistanceSlider, StringFormat={}{0:0} px}" />
                        <TextBlock Grid.Row="1" Text="フェンスの間隔" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <Slider x:Name="SnapGapSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="32" Margin="0,12,0,0"
                                IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="10,12,0,0" VerticalAlignment="Center"
                                   Text="{Binding Value, ElementName=SnapGapSlider, StringFormat={}{0:0} px}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ===== 自動振り分け ===== -->
            <TabItem Header="自動振り分け">
                <DockPanel Margin="16,8,16,12">
                    <StackPanel DockPanel.Dock="Top">
                        <CheckBox x:Name="AutoSortBox" Content="デスクトップの項目を、ルールに従ってフェンスへ自動で振り分ける" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="どのフェンスにも入っていないデスクトップ項目が対象です（新しく置かれたとき・起動時・「今すぐ振り分ける」で実行）。ルールは上から順に調べ、最初に当てはまったものを使います。手でフェンスから外した項目は、ルールで戻しません。" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                        <Button Content="今すぐ振り分ける" Click="OnRunNow" />
                        <Button x:Name="ClearExclusionsButton" Margin="8,0,0,0" Click="OnClearExclusions" />
                        <TextBlock x:Name="RunResultText" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.8" />
                    </DockPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="280" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>

                        <!-- ルール一覧 -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="追加" MinWidth="64" Click="OnAddRule" />
                                <Button x:Name="RemoveRuleButton" Content="削除" MinWidth="64" Margin="6,0,0,0" Click="OnRemoveRule" />
                                <Button x:Name="UpButton" Content="↑" MinWidth="40" Margin="6,0,0,0" Click="OnMoveUp" ToolTip="上へ（優先）" />
                                <Button x:Name="DownButton" Content="↓" MinWidth="40" Margin="6,0,0,0" Click="OnMoveDown" ToolTip="下へ" />
                            </StackPanel>
                            <ListBox x:Name="RuleList" SelectionChanged="OnRuleSelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:RuleViewModel}">
                                        <DockPanel Margin="0,2">
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                      Margin="0,0,8,0" MinWidth="0" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="#FFE05050"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <!-- 選んだルールの編集 -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RuleEditor">
                                <TextBlock Text="名前" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                                <TextBlock Text="条件" />
                                <ComboBox x:Name="KindCombo" Margin="0,4,0,6" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Kind}" />
                                <TextBox x:Name="PatternBox" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsTextPattern, Converter={StaticResource BoolToVis}}" />
                                <ComboBox x:Name="CategoryCombo" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding Category}"
                                          Visibility="{Binding IsCategory, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding PatternHint}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,10" />

                                <TextBlock Text="振り分け先のフェンス" />
                                <DockPanel Margin="0,4,0,10">
                                    <Button DockPanel.Dock="Right" Content="新しいフェンスを作る" Margin="8,0,0,0" Click="OnCreateTargetFence" />
                                    <ComboBox x:Name="TargetCombo" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding TargetFenceId}" />
                                </DockPanel>

                                <TextBlock Text="{Binding Error}" Foreground="#FFE05050" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />

                                <Border BorderThickness="1" BorderBrush="#40808080" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <TextBlock x:Name="MatchTitle" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MatchList" FontSize="12" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="NoRuleText" Grid.Column="2" Text="左の「追加」でルールを作ります。" Opacity="0.7"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ===== 外観 ===== -->
            <TabItem Header="外観">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="新しいフェンスの外観" Style="{StaticResource SectionTitle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.8"
                               Text="これから作るフェンスの既定の外観です。個々のフェンスは、フェンスの右クリック →「外観の設定…」で変更できます。" />
                    <Button Content="既定の外観を編集…" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnEditDefaultStyle" />
                </StackPanel>
            </TabItem>

            <!-- ===== 情報 ===== -->
            <TabItem Header="情報">
                <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Fako（ファーコ）" Style="{StaticResource SectionTitle}" FontSize="20" />
                    <TextBlock x:Name="VersionText" />
                    <TextBlock Text="デスクトップのアイコンを「フェンス」でまとめる整理ツール" Opacity="0.8" Margin="0,4,0,0" />

                    <TextBlock Text="ファイル" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ConfigPathText" TextWrapping="Wrap" />
                    <TextBlock x:Name="LogPathText" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="設定フォルダーを開く" Click="OnOpenConfigFolder" />
                        <Button Content="ログを開く" Margin="8,0,0,0" Click="OnOpenLog" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
